<mxfile host="app.diagrams.net">
  <diagram name="UML" id="poGEJpCo2QzgFd77dIBu">
    <mxGraphModel dx="2298" dy="763" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Core Module Classes\n    class AuthManager {\n        -token_manager: TokenManager\n        -mail_dispatcher: MailDispatcher\n        -user_repository: UserRepository\n        -password_policy: PasswordPolicy\n        -password_hasher: PasswordHasher\n        -i18n: I18nManager\n        -base_url: str\n        +register_user(email, password) bool\n        +reset_password(email, password) bool\n        +verify_user(token) bool\n        +verify_password_reset_token(token) str|None\n        +authenticate_user(email, password) bool\n        +get_or_create_oauth_user(email, name, provider) dict\n        +request_password_recovery(email) bool\n    }\n\n    class TokenManager {\n        -secret_key: str\n        -salt: str\n        -serializer: URLSafeTimedSerializer\n        +generate_token(data) str\n        +confirm_token(token, expiration_seconds) Any|None\n    }\n\n    class I18nManager {\n        -locale: str\n        -translations: dict\n        +get_locale() str\n        +set_locale(locale)\n        +load_custom_translations(custom)\n        +translate(key, **kwargs) str\n    }\n\n    %% Database / Repository Pattern\n    class UserRepository {\n        &lt;&lt;interface&gt;&gt;\n        +get_user_by_email(email) dict|None\n        +create_user(email, password_hash, verified, name, oauth_provider)\n        +update_user_password(email, new_password_hash)\n        +update_user_verification(email, verified)\n    }\n\n    class SQLiteUserRepository {\n        -db_path: str\n        -_initialize_db()\n        -_get_connection() sqlite3.Connection\n    }\n\n    %% Mail Dispatchers\n    class MailDispatcher {\n        &lt;&lt;interface&gt;&gt;\n        +send(to_email, subject, body, logo_image_file)\n    }\n\n    class ConsoleMailDispatcher {\n        +send(to_email, subject, body, logo_image_file)\n    }\n\n    class SmtpMailDispatcher {\n        -_mail: Mail\n        +initialize(config: AbsEmailServerConfig)\n        +send(to_email, subject, body, logo_image_file)\n    }\n\n    class AbsEmailServerConfig {\n        &lt;&lt;interface&gt;&gt;\n        +mail_server: str\n        +mail_port: int\n        +mail_username: str\n        +mail_password: str\n        +name_sender: str\n        +mail_sender_address: str\n        +mail_use_tls: bool\n    }\n\n    class EmailEnvConfig {\n        +mail_server: str\n        +mail_port: int\n        +mail_username: str\n        +mail_password: str\n        +name_sender: str\n        +mail_sender_address: str\n        +mail_use_tls: bool\n    }\n\n    %% Security - Hasher\n    class PasswordHasher {\n        &lt;&lt;interface&gt;&gt;\n        +hash(password) str\n        +verify(password, hashed) bool\n    }\n\n    class WerkzeugPasswordHasher {\n        +hash(password) str\n        +verify(password, hashed) bool\n    }\n\n    %% Security - Password Policy\n    class PasswordPolicy {\n        -config: PasswordPolicyConfig\n        +validate(password, i18n_manager) tuple\n    }\n\n    class PasswordPolicyConfig {\n        +rules: list~PasswordRule~\n        +msg_valid: str\n    }\n\n    class PasswordRule {\n        &lt;&lt;interface&gt;&gt;\n        +validate(password) tuple\n    }\n\n    class LengthPasswordRule {\n        +value: int\n        +message: str\n        +validate(password) tuple\n    }\n\n    class RegexPasswordRule {\n        +pattern: str\n        +message: str\n        +validate(password) tuple\n    }\n\n    %% Flask Extension Layer\n    class AuthExtension {\n        -auth_manager: AuthManager\n        -locale: str\n        -i18n: I18nManager\n        +init_app(app, auth_manager)\n    }\n\n    %% Relationships\n    \n    %% AuthManager uses/aggregates/composes different parts\n    AuthManager *-- TokenManager : \&quot;creates\&quot;\n    AuthManager *-- I18nManager : \&quot;creates (backend)\&quot;\n    AuthManager o-- MailDispatcher : \&quot;injects\&quot;\n    AuthManager o-- UserRepository : \&quot;injects\&quot;\n    AuthManager o-- PasswordPolicy : \&quot;injects\&quot;\n    AuthManager o-- PasswordHasher : \&quot;injects\&quot;\n    \n    %% Repository Inheritance\n    UserRepository &lt;|-- SQLiteUserRepository : \&quot;implements\&quot;\n    \n    %% Mail Inheritance &amp; Config Usage\n    MailDispatcher &lt;|-- ConsoleMailDispatcher : \&quot;implements\&quot;\n    MailDispatcher &lt;|-- SmtpMailDispatcher : \&quot;implements\&quot;\n    SmtpMailDispatcher ..&gt; AbsEmailServerConfig : \&quot;uses config\&quot;\n    AbsEmailServerConfig &lt;|-- EmailEnvConfig : \&quot;implements\&quot;\n\n    %% Security Hasher\n    PasswordHasher &lt;|-- WerkzeugPasswordHasher : \&quot;implements\&quot;\n\n    %% Password Policy\n    PasswordPolicy o-- PasswordPolicyConfig : \&quot;contains\&quot;\n    PasswordPolicyConfig o-- PasswordRule : \&quot;list of rules\&quot;\n    PasswordRule &lt;|-- LengthPasswordRule : \&quot;implements\&quot;\n    PasswordRule &lt;|-- RegexPasswordRule : \&quot;implements\&quot;\n\n    %% Extension\n    AuthExtension o-- AuthManager : \&quot;wraps\&quot;\n    AuthExtension *-- I18nManager : \&quot;creates (frontend)\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="H3W6DT5V06kCKmJLKbV8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;labelBackgroundColor=none;fontColor=#000000;fontFamily=Helvetica;" vertex="1">
            <mxGeometry height="1738" width="3337" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AuthManager&lt;/b&gt;" mermaidId="n:AuthManager" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;AuthManager&lt;/b&gt;" id="H3W6DT5V06kCKmJLKbV8-2">
